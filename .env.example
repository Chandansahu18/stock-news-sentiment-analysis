# Copy this file to ".env" and fill in your own values. NEVER commit ".env".

# Upstox Analytics Token (read-only, 1-year validity). Used for prices and the daily rankings only.
# News always comes from Google News RSS, which needs no key.
# Generate it from your app on https://account.upstox.com/developer/apps
UPSTOX_ANALYTICS_TOKEN=

# Cache settings (JSON files under CACHE_DIR; no database).
CACHE_DIR=cache
NEWS_TTL_MINUTES=30
PRICE_TTL_MINUTES=5
MAX_ARTICLES=20

# Today's stocks: how many to show per list (10 to 20) and how often the ranking is recomputed.
TOP_STOCKS_COUNT=20
TOP_STOCKS_TTL_MINUTES=20

# Load the FinBERT model and the NSE stock list in the background when the API starts, so the first
# visitor does not wait for them. Set to false to skip this while developing.
PRELOAD_ON_STARTUP=true

# Sentiment model (Hugging Face id). FinBERT = BERT trained on financial text.
FINBERT_MODEL=ProsusAI/finbert

# Streamlit -> API address
API_BASE_URL=http://127.0.0.1:8010
